# HTTPS for the whole site; Caddy gets and renews the certificate for {$DOMAIN} by itself.
{$DOMAIN} {
	encode zstd gzip

	# Proof photos and other uploads. Their names are random, so links can't be guessed.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "private, max-age=86400"
		file_server
	}

	# Everything else: the API, the admin and the mini app at /app/.
	handle {
		reverse_proxy backend:8000
	}
}
