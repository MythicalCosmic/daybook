# Davomat's settings, at the checkout's root as .env (mode 600: it holds the keys).
# deploy/davomat/install.sh writes it once and never overwrites it; docs/davomat/en/INSTALL.md.
# By hand: copy this file to .env and fill in every empty value marked "required".

# The edition: Davomat (Face ID attendance). docker-compose.davomat.yml sets it too.
EDITION=davomat

# --- The address ---------------------------------------------------------------------------
# Required. The site's name: a domain whose DNS points at this server (davomat.example.uz), the
# server's public IP with .nip.io (203.0.113.10.nip.io: works without a domain), or on a local
# network the server's address (192.168.1.10).
DOMAIN=
# Required: the same name (Django answers no other).
DJANGO_ALLOWED_HOSTS=
# Required: https://<DOMAIN>/dashboard/, for the "Open Davomat" buttons in Telegram.
DASHBOARD_URL=
# Where Face ID terminals post, shown on each terminal's setup page: the server's IP (old
# firmware takes no names). Empty: the host of DASHBOARD_URL.
PUBLIC_DEVICE_HOST=
# Empty: a public certificate from Let's Encrypt. local_certs: the server's own certificate, for a
# server only a local network reaches (browsers ask once to trust it).
CADDY_OPTIONS=
# Caddyfile (HTTPS, the default) or Caddyfile.http (plain HTTP: a trial on this computer only,
# at http://localhost; sign-in doesn't last at any other address over plain HTTP).
CADDYFILE=Caddyfile
# Ports on the server. Terminals and certificates need 80 and 443.
HTTP_PORT=80
HTTPS_PORT=443
# Empty: listen on every address. 127.0.0.1: (with the colon) this computer only.
LISTEN_PREFIX=

# --- Keys (required; generate them once and never change them) -----------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Only takes effect when the database is first created.
POSTGRES_PASSWORD=
# The Telegram bot token is stored encrypted with this Fernet key. A lost key means pasting the
# token again; never change it while data is stored (a new key goes first, comma-separated):
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=
# Any long random string, like the secret key.
FIELD_HASH_KEY=

# --- Behaviour ------------------------------------------------------------------------------
# true: write Telegram messages to the log instead of sending them (tests and demos).
TELEGRAM_DRY_RUN=false
# Organizations are made by the setup page (or manage.py davomat_init), never by a bot.
COMPANY_SIGNUP=off
# Once HTTPS works, browsers can be told to insist on it (a year = 31536000).
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_SSL_REDIRECT=false
LOG_LEVEL=INFO

# --- Size (the defaults suit 2 vCPU and 4 GB; raise them on a bigger server) ----------------
# gunicorn processes (4 threads each)
GUNICORN_WORKERS=3
# Celery worker processes (one job each at a time)
CELERY_CONCURRENCY=2
# Threads the Telegram bot runs its database calls on
BOT_DB_THREADS=8
# Postgres memory: about a quarter of the server's memory, and half
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB

# --- Backups (deploy/davomat/backup.sh, restore.sh) -----------------------------------------
# Every night at this time, in this time zone; kept this many days.
BACKUP_TIME=02:30
BACKUP_TZ=Asia/Tashkent
BACKUP_KEEP_DAYS=14
# Where they go on the server (relative to the checkout). Copy them off the server regularly.
DAVOMAT_BACKUP_DIR=./backups
