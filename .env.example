# Copy to .env and fill in. Host ports match docker-compose.yml.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Origins allowed to call /api/ from a browser, e.g. the mini app's https://app.example.com
CORS_ALLOWED_ORIGINS=

# Infrastructure
DATABASE_URL=postgres://trello:trello@localhost:25432/trello
# Cache, Celery broker and bot conversations all use Redis database 0, the lead's in
# deploy/dev-packages.mk: databases 1-19 belong to the work packages (`make run PKG=e` …), and a
# worker on another package's database would run that package's tasks against this database.
REDIS_URL=redis://localhost:26379/0
CELERY_BROKER_URL=redis://localhost:26379/0
BOT_FSM_REDIS_URL=redis://localhost:26379/0
# Seconds a database connection is kept open between requests (the stream service uses 0, and
# so do the Makefile's dev servers, workers and bots)
DB_CONN_MAX_AGE=60
# Put in front of every key apps.core.redis writes, when several setups share one Redis
REDIS_KEY_PREFIX=
# Development: run Celery tasks inline when no worker is running
CELERY_TASK_ALWAYS_EAGER=false

# Files. Public uploads (proof photos, logos) and private ones (receipts, documents, exports,
# PDFs: only ever served through signed links). Uncomment only to move them elsewhere; the
# defaults are backend/media and backend/private_media (and the Docker volumes in containers).
# MEDIA_ROOT=/srv/trello/media
# PRIVATE_MEDIA_ROOT=/srv/trello/private_media
# Lesson videos and their posters (private, signed links; default backend/learning_media, the
# learning_media volume in containers). Big, so the daily backup leaves them out.
# LEARNING_MEDIA_ROOT=/srv/trello/learning_media
# Production sets this in docker-compose.prod.yml: Django checks a video link and answers
# X-Accel-Redirect under this prefix, and Caddy sends the bytes (deploy/Caddyfile). Empty:
# Django streams the video itself (development).
# LEARNING_MEDIA_ACCEL=/_learning/

# Field encryption for ID numbers and cards. Keep both secret and never change them once data
# is stored (a new Fernet key goes first, comma-separated, to rotate):
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=
# Any long random string: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
FIELD_HASH_KEY=

# Telegram
EMPLOYEE_BOT_TOKEN=
# Without the @, used to build company invite links, e.g. daily_taskmanagment_bot
EMPLOYEE_BOT_USERNAME=
# Optional: the owner bot (create a company, dashboard logins, briefings, approvals). Without
# it the employee bot confirms logins and delivers owner notifications.
OWNER_BOT_TOKEN=
# Without the @, e.g. owner_taskmanagment_bot
OWNER_BOT_USERNAME=
EMPLOYEE_MINIAPP_URL=
# Comma-separated Telegram user ids of platform super-admins
PLATFORM_ADMIN_TG_IDS=
# true: log bot messages instead of sending them
TELEGRAM_DRY_RUN=false
# How old Mini App launch data may be before sign-in is refused, in seconds
MINIAPP_INIT_DATA_MAX_AGE=86400
OWNER_INIT_DATA_MAX_AGE=3600

# Owner dashboard (/dashboard/)
# Public address, for "Open dashboard" buttons in the bots, e.g. https://tasks.example.com/dashboard/
DASHBOARD_URL=
# Minutes an owner access token lives (the browser refreshes it)
OWNER_ACCESS_TOKEN_MINUTES=15
# Development only (needs DJANGO_DEBUG=true): sign in to the dashboard as any demo person
DASHBOARD_DEV_LOGIN=false
# Who may create a company in the owner bot: code (a signup code from a platform admin), open, off
COMPANY_SIGNUP=code
# Companies one person may own, unless they are a platform admin
MAX_COMPANIES_PER_USER=10
# Built front ends; uncomment only to move them (defaults: miniapp/dist and dashboard/dist)
# MINIAPP_DIST=/srv/trello/miniapp
# DASHBOARD_DIST=/srv/trello/dashboard

# AI (optional; everything works without a key)
ANTHROPIC_API_KEY=
# Development and demos: canned, deterministic answers without a key
AI_FAKE=false
AI_MODEL_CHAT=claude-sonnet-5-5
AI_MODEL_DEEP=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5
# Voice and typed instructions turned into task drafts (one structured call, effort low)
AI_MODEL_DRAFTS=claude-opus-5-5
# What all companies together may spend in a month, in USD (one key pays for everyone)
AI_GLOBAL_MONTHLY_CAP_USD=200
# Speech to text for voice messages (Claude takes no audio). Any OpenAI-compatible
# /audio/transcriptions service: the local Whisper service (deploy/stt) http://stt:8000/v1,
# OpenAI https://api.openai.com/v1 (model gpt-4o-transcribe) or Groq
# https://api.groq.com/openai/v1 (model whisper-large-v3). Empty: voice is off (typed text still
# works); with AI_FAKE=true and no URL a canned transcript is used.
AI_SPEECH_URL=
# Sent as "Authorization: Bearer <key>" only when set (the local service needs none)
AI_SPEECH_API_KEY=
AI_SPEECH_MODEL=large-v3
# Seconds to wait for one transcription
AI_SPEECH_TIMEOUT=90
# A model per language (the others use AI_SPEECH_MODEL). With OpenAI use gpt-4o-transcribe for
# every language: ~1 s for a 10 s note; gpt-4o-mini-transcribe can't write Uzbek and mishears
# names and times in Russian (tested 2026-11-02)
AI_SPEECH_MODELS_BY_LANGUAGE=
# A second service when the first fails (down, out of credit, too slow): the server's own
# Whisper, http://stt:8000/v1, no key
AI_SPEECH_FALLBACK_URL=
AI_SPEECH_FALLBACK_MODEL=large-v3
AI_SPEECH_FALLBACK_TIMEOUT=600

# Development tools
# `make demo` / seed_demo: only these apps' demo data, e.g. sales,finance (empty: every app)
DEMO_APPS=
# `manage.py spectacular`: employee (the mini app's types), owner (the dashboard's) or empty (all)
SCHEMA_AUDIENCE=

# Production only (docker-compose.prod.yml, see docs/DEPLOY.md)
# The site's domain; Caddy gets its HTTPS certificate. Also set DJANGO_ALLOWED_HOSTS to it,
# DJANGO_DEBUG=false and EMPLOYEE_MINIAPP_URL=https://<DOMAIN>/app/
DOMAIN=
POSTGRES_PASSWORD=
# Once HTTPS works: browsers then insist on it for this long (a year = 31536000)
DJANGO_SECURE_HSTS_SECONDS=0
# Caddy already redirects to HTTPS; leave this off unless something else sits in front
DJANGO_SECURE_SSL_REDIRECT=false
LOG_LEVEL=INFO

# Performance (optional; the defaults suit 12 vCPU and a few hundred people at once, see
# docs/DEPLOY.md "Performance")
# gunicorn: processes, threads each, seconds before a request is cut off
# GUNICORN_WORKERS=12
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=60
# Threads each bot runs its database calls on (each keeps a connection)
# BOT_DB_THREADS=16
# Celery worker processes and how many jobs each takes at a time
# CELERY_CONCURRENCY=8
# CELERY_PREFETCH=1
# Postgres: raise together with gunicorn's workers or threads
# POSTGRES_MAX_CONNECTIONS=200
# Rate limits by name, e.g. telegram_auth_address=2000/min,login_link=600/min
# THROTTLE_RATES=
# Proxies in front of Django that add X-Forwarded-For (Caddy: 1; a CDN in front of it: 2)
# NUM_PROXIES=1
