# Copy to .env and fill in. Host ports match docker-compose.yml.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Origins allowed to call /api/ from a browser, e.g. the mini app's https://app.example.com
CORS_ALLOWED_ORIGINS=

# Infrastructure
DATABASE_URL=postgres://trello:trello@localhost:25432/trello
REDIS_URL=redis://localhost:26379/0
CELERY_BROKER_URL=redis://localhost:26379/1
BOT_FSM_REDIS_URL=redis://localhost:26379/2
# Seconds a database connection is kept open between requests (the stream service uses 0)
DB_CONN_MAX_AGE=60
# Put in front of every key apps.core.redis writes, when several setups share one Redis
REDIS_KEY_PREFIX=
# Development: run Celery tasks inline when no worker is running
CELERY_TASK_ALWAYS_EAGER=false

# Files. Public uploads (proof photos, logos) and private ones (receipts, documents, exports,
# PDFs: only ever served through signed links). Uncomment only to move them elsewhere; the
# defaults are backend/media and backend/private_media (and the Docker volumes in containers).
# MEDIA_ROOT=/srv/trello/media
# PRIVATE_MEDIA_ROOT=/srv/trello/private_media

# Field encryption for ID numbers and cards. Keep both secret and never change them once data
# is stored (a new Fernet key goes first, comma-separated, to rotate):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Any long random string: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
FIELD_HASH_KEY=

# Telegram
EMPLOYEE_BOT_TOKEN=
# Without the @, used to build company invite links, e.g. daily_taskmanagment_bot
EMPLOYEE_BOT_USERNAME=
# Optional: the owner bot (create a company, dashboard logins, briefings, approvals). Without
# it the employee bot confirms logins and delivers owner notifications.
OWNER_BOT_TOKEN=
# Without the @, e.g. owner_taskmanagment_bot
OWNER_BOT_USERNAME=
EMPLOYEE_MINIAPP_URL=
# Comma-separated Telegram user ids of platform super-admins
PLATFORM_ADMIN_TG_IDS=
# true: log bot messages instead of sending them
TELEGRAM_DRY_RUN=false
# How old Mini App launch data may be before sign-in is refused, in seconds
MINIAPP_INIT_DATA_MAX_AGE=86400
OWNER_INIT_DATA_MAX_AGE=3600

# Owner dashboard (/dashboard/)
# Public address, for "Open dashboard" buttons in the bots, e.g. https://tasks.example.com/dashboard/
DASHBOARD_URL=
# Minutes an owner access token lives (the browser refreshes it)
OWNER_ACCESS_TOKEN_MINUTES=15
# Development only (needs DJANGO_DEBUG=true): sign in to the dashboard as any demo person
DASHBOARD_DEV_LOGIN=false
# Who may create a company in the owner bot: code (a signup code from a platform admin), open, off
COMPANY_SIGNUP=code
# Companies one person may own, unless they are a platform admin
MAX_COMPANIES_PER_USER=10
# Built front ends; uncomment only to move them (defaults: miniapp/dist and dashboard/dist)
# MINIAPP_DIST=/srv/trello/miniapp
# DASHBOARD_DIST=/srv/trello/dashboard

# AI (optional; everything works without a key)
ANTHROPIC_API_KEY=
# Development and demos: canned, deterministic answers without a key
AI_FAKE=false
AI_MODEL_CHAT=claude-sonnet-5-5
AI_MODEL_DEEP=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5
# What all companies together may spend in a month, in USD (one key pays for everyone)
AI_GLOBAL_MONTHLY_CAP_USD=200

# Development tools
# `make demo` / seed_demo: only these apps' demo data, e.g. sales,finance (empty: every app)
DEMO_APPS=
# `manage.py spectacular`: employee (the mini app's types), owner (the dashboard's) or empty (all)
SCHEMA_AUDIENCE=

# Production only (docker-compose.prod.yml, see docs/DEPLOY.md)
# The site's domain; Caddy gets its HTTPS certificate. Also set DJANGO_ALLOWED_HOSTS to it,
# DJANGO_DEBUG=false and EMPLOYEE_MINIAPP_URL=https://<DOMAIN>/app/
DOMAIN=
POSTGRES_PASSWORD=
# Once HTTPS works: browsers then insist on it for this long (a year = 31536000)
DJANGO_SECURE_HSTS_SECONDS=0
# Caddy already redirects to HTTPS; leave this off unless something else sits in front
DJANGO_SECURE_SSL_REDIRECT=false
LOG_LEVEL=INFO
