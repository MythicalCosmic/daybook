msgid "Start with /new to create your company."
msgstr "Kompaniyangizni yaratish uchun /new buyrug‘ini yuboring."

#: owner_bot/ownerbot/bot_messages.py
msgid "Your dashboard: every task, sale, payment and person in one place."
msgstr ""
"Boshqaruv panelingiz: barcha vazifalar, savdolar, to‘lovlar va xodimlar bir "
"joyda."

#: owner_bot/ownerbot/bot_messages.py
#, python-format
msgid "Open your dashboard: %(url)s"
msgstr "Boshqaruv panelingizni oching: %(url)s"

