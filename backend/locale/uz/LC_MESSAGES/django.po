msgid "Give a date or a date and time."
msgstr "Sanani yoki sana va vaqtni kiriting."

#: backend/apps/agenda/serializers.py
msgid "Use a date like 2026-10-24."
msgstr "Sanani 2026-10-24 ko‘rinishida kiriting."

#: backend/apps/agenda/serializers.py
msgid "Use a time like 2026-10-24T10:00."
msgstr "Vaqtni 2026-10-24T10:00 ko‘rinishida kiriting."

#: backend/apps/agenda/serializers.py backend/apps/projects/owner_api.py
#: backend/apps/projects/services.py
msgid "The end can't be before the start."
msgstr "Tugash sanasi boshlanish sanasidan oldin bo‘lishi mumkin emas."

#: backend/apps/agenda/serializers.py
msgid "Ask for at most two months at a time."
msgstr "Bir martada ko‘pi bilan ikki oylik davrni so‘rang."

#: backend/apps/agenda/services.py
msgid "Only people who manage the calendar can do this."
msgstr "Buni faqat taqvimni boshqaradiganlar qila oladi."

#: backend/apps/agenda/services.py
msgid "The event can't end before it starts."
msgstr "Tadbir boshlanishidan oldin tugay olmaydi."

#: backend/apps/agenda/services.py
msgid "Give the time it starts, or make it an all-day event."
msgstr ""
"Boshlanish vaqtini kiriting yoki uni kun bo‘yi davom etadigan tadbir qiling."

#: backend/apps/agenda/services.py
msgid "Give the time it ends."
msgstr "Tugash vaqtini kiriting."

#: backend/apps/agenda/services.py
msgid "The event must end after it starts."
msgstr "Tadbir boshlangandan keyin tugashi kerak."

#: backend/apps/agenda/services.py
msgid "A timed event can last two weeks at most. Make it all-day."
msgstr ""
"Vaqti belgilangan tadbir ko‘pi bilan ikki hafta davom etishi mumkin. Uni kun "
"bo‘yi davom etadigan tadbir qiling."

#: backend/apps/agenda/services.py
msgid "Pick how it repeats."
msgstr "Qanday takrorlanishini tanlang."

#: backend/apps/agenda/services.py
msgid "It can't stop repeating before it starts."
msgstr "Takrorlanish tadbir boshlanishidan oldin tugay olmaydi."

#: backend/apps/agenda/services.py
msgid "A reminder can come at most a week before."
msgstr "Eslatma ko‘pi bilan bir hafta oldin yuborilishi mumkin."

#: backend/apps/agenda/services.py backend/apps/members/owner_api.py
