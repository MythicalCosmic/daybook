msgstr ""
"Bir kun o‘tdi, lekin %(total)d kishidan %(unread)d tasi hali «%(title)s» "
"e’loningizni o‘qimadi: %(names)s"

#: backend/apps/announcements/bot_messages.py
#: backend/apps/groups/bot_messages.py backend/apps/reports/bot_messages.py
#, python-format
msgid "…and %(count)d more"
msgstr "…va yana %(count)d ta"

#: backend/apps/announcements/bot_messages.py
msgid "Who has read it?"
msgstr "Kim o‘qidi?"

#: backend/apps/announcements/bot_messages.py
#: backend/apps/attendance/bot_messages.py backend/apps/tasks/bot_messages.py
#: employee_bot/bot/handlers/member/tasks.py owner_bot/ownerbot/bot_messages.py
