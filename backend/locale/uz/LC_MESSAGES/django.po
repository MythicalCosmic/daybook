msgstr "Seans tugadi. Boshqaruv panelini botdan qayta oching."

#: backend/apps/signin/signup.py
msgid "A signup code needs at least one use."
msgstr ""
"Ro‘yxatdan o‘tish kodi kamida bir marta ishlatishga mo‘ljallangan bo‘lishi "
"kerak."

#: backend/apps/signin/signup.py
msgid "This signup code isn't valid. Check it, or ask for a new one."
msgstr ""
"Bu ro‘yxatdan o‘tish kodi yaroqsiz. Uni tekshiring yoki yangisini so‘rang."

#: backend/apps/signin/signup.py
msgid "New companies are created by the platform team for now."
msgstr "Hozircha yangi kompaniyalarni platforma jamoasi yaratadi."

#: backend/apps/signin/signup.py
msgid "Enter the signup code you were given."
msgstr "Sizga berilgan ro‘yxatdan o‘tish kodini kiriting."

#: backend/apps/tasks/ai_tools.py
msgid ""
"Find tasks by status, person, position, due dates or words in the title."
msgstr ""
"Vazifalarni holat, xodim, lavozim, muddat yoki nomidagi so‘zlar bo‘yicha "
"qidirish."

#: backend/apps/tasks/ai_tools.py
msgid ""
"One task in detail: checklist progress, reminders sent, latest comments."
msgstr ""
"Bitta vazifa batafsil: nazorat ro‘yxati qadamlarining bajarilishi, yuborilgan"
" eslatmalar, so‘nggi izohlar."

#: backend/apps/tasks/ai_tools.py
msgid ""
"Storage readings (fridge and room temperature, humidity): values out of range"
