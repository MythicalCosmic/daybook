msgid ""
"That wasn't the number on the screen, so this sign-in was cancelled. If it "
"was you, start again in your browser."
msgstr ""
"Bu ekrandagi raqam emas edi, shuning uchun kirish bekor qilindi. Agar bu siz "
"bo‘lsangiz, brauzerda qaytadan boshlang."

#: backend/apps/signin/bot_messages.py
msgid "Cancelled. Nobody was signed in."
msgstr "Bekor qilindi. Hech kim tizimga kirmadi."

#: backend/apps/signin/bot_messages.py
msgid "Signed in to the dashboard"
msgstr "Boshqaruv paneliga kirildi"

#: backend/apps/signin/bot_messages.py
msgid "Not you? Log out everywhere and nobody stays signed in."
msgstr ""
"Bu siz emasmisiz? Barcha qurilmalardan chiqing, shunda hech kim tizimda "
"qolmaydi."

#: backend/apps/signin/bot_messages.py
msgid "Log out everywhere"
msgstr "Barcha qurilmalardan chiqish"

#: backend/apps/signin/bot_messages.py
msgid "You were already signed out everywhere."
msgstr "Siz allaqachon barcha qurilmalardan chiqqansiz."

