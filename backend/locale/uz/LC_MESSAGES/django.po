msgid "Your request is waiting for approval. I'll message you as soon as it's decided."
msgstr "So‘rovingiz tasdiqlanishini kutmoqda. Qaror chiqishi bilan sizga yozaman."

#: backend/apps/members/bot_messages.py
msgid "Use the menu below to see your tasks or add one."
msgstr "Vazifalaringizni ko‘rish yoki yangisini qo‘shish uchun quyidagi menyudan foydalaning."

#: backend/apps/members/bot_messages.py
msgid "Accounts are created in the app, which isn't set up yet. Ask your manager."
msgstr "Hisob ilovada yaratiladi, lekin u hali sozlanmagan. Rahbaringizga murojaat qiling."

#: backend/apps/members/bot_messages.py
msgid "📱 Create account"
msgstr "📱 Hisob yaratish"

#: backend/apps/members/bot_messages.py
