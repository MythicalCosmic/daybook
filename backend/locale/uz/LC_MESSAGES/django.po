msgstr "👋 Salom! Kompaniyangizga qo‘shilish uchun rahbaringiz yuborgan taklif havolasini oching."

#: backend/apps/members/bot_messages.py
#, python-format
msgid "👋 Welcome! You're joining <b>%(company)s</b>."
msgstr "👋 Xush kelibsiz! Siz <b>%(company)s</b> kompaniyasiga qo‘shilyapsiz."

