msgstr "Hisobingizni yaratish uchun ilovani oching: ismingiz, telefoningiz va lavozimingiz."

#: backend/apps/members/bot_messages.py
msgid "📱 Share my phone number"
msgstr "📱 Raqamimni ulashish"

#: backend/apps/members/bot_messages.py
