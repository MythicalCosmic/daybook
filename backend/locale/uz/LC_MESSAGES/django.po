msgid "You can only add events at your own branches."
msgstr "Faqat o‘z filiallaringizda tadbir qo‘sha olasiz."

#: backend/apps/agenda/services.py
#, python-format
msgid "Invite at most %(n)d people."
msgstr "Ko‘pi bilan %(n)d kishini taklif qiling."

#: backend/apps/agenda/services.py
msgid "Invite people of this company you can see."
msgstr "Shu kompaniyadan o‘zingiz ko‘ra oladigan odamlarni taklif qiling."

#: backend/apps/agenda/services.py
msgid "Give the event a name."
msgstr "Tadbirga nom bering."

#: backend/apps/agenda/services.py
msgid "Pick a kind of event."
msgstr "Tadbir turini tanlang."

#: backend/apps/agenda/services.py
msgid "Pick who sees the event."
msgstr "Tadbirni kim ko‘rishini tanlang."

#: backend/apps/agenda/services.py
msgid "You don't have access to this event."
msgstr "Bu tadbirga kirish huquqingiz yo‘q."

#: backend/apps/agenda/services.py
msgid "Answer going or can't come."
msgstr "«Boraman» yoki «Bora olmayman» deb javob bering."

