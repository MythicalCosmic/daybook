#: backend/apps/audit/models.py
msgid "Empty when the system did it."
msgstr "Tizim bajargan bo‘lsa, bo‘sh."

#: backend/apps/audit/models.py
msgid "Its name at the time."
msgstr "O‘sha paytdagi nomi."

#: backend/apps/companies/admin.py
msgid "Members"
msgstr "Xodimlar"

#: backend/apps/companies/admin.py
msgid "Invite link"
msgstr "Taklif havolasi"

#: backend/apps/companies/admin.py
msgid "Set EMPLOYEE_BOT_USERNAME to build the link"
msgstr "Havola uchun EMPLOYEE_BOT_USERNAME ni sozlang"

#: backend/apps/companies/admin.py
msgid "Regenerate invite links"
msgstr "Taklif havolalarini yangilash"

#: backend/apps/companies/admin.py
