msgstr "Bu kirish so‘rovi Telegramda bekor qilingan."

#: backend/apps/signin/owner_api.py
msgid "This sign-in has expired. Get a new code."
msgstr "Kirish so‘rovining muddati tugadi. Yangi kod oling."

#: backend/apps/signin/owner_api.py
msgid "This sign-in can't be used. Start again."
msgstr "Bu kirish so‘rovidan foydalanib bo‘lmaydi. Qaytadan boshlang."

#: backend/apps/signin/owner_api.py
