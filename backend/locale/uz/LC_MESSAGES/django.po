#: backend/apps/announcements/services.py
#: employee_bot/bot/handlers/member/announcements.py
msgid "Only managers can send announcements."
msgstr "E’lonni faqat rahbarlar yubora oladi."

#: backend/apps/announcements/services.py
msgid "Only a scheduled announcement can be changed."
msgstr "Faqat rejalashtirilgan e’lonni o‘zgartirish mumkin."

#: backend/apps/announcements/services.py
msgid "Only a scheduled announcement can be cancelled."
msgstr "Faqat rejalashtirilgan e’lonni bekor qilish mumkin."

#: backend/apps/announcements/services.py
msgid "This announcement was cancelled."
msgstr "Bu e’lon bekor qilingan."

#: backend/apps/announcements/services.py
msgid "Pick a moment in the future."
msgstr "Kelajakdagi vaqtni tanlang."

#: backend/apps/announcements/services.py
msgid "Keep it pinned until after it goes out."
msgstr "Qadab qo‘yish muddati e’lon yuborilgandan keyin tugashi kerak."

