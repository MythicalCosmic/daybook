msgstr[0] ""
"Ish haqi hisoblandi (%(month)s): ish haqi kunigacha hal qilinadigan masalalar"
" — %(count)s ta"

#: backend/apps/ai/agents/hr_assistant.py
#, python-format
msgid "Suggested %(count)s bonus for %(month)s: it waits for approval"
