msgid "Type another"
msgstr "Boshqasini yozish"

#: owner_bot/ownerbot/bot_messages.py
msgid "Send the timezone or city, like Asia/Samarkand or Bishkek."
msgstr ""
"Vaqt mintaqasi yoki shahar nomini yuboring, masalan, Asia/Samarkand yoki "
"Bishkek."

#: owner_bot/ownerbot/bot_messages.py
msgid ""
"I don't know that timezone. Try a city name, like Almaty or Asia/Bishkek."
msgstr ""
"Bunday vaqt mintaqasini bilmayman. Shahar nomini yozib ko‘ring, masalan, "
"Almaty yoki Asia/Bishkek."

