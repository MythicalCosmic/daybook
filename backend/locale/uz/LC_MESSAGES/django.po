#, python-format
msgid ""
"Payroll %(month)s is calculated: %(count)s thing to settle before pay day"
msgid_plural ""
"Payroll %(month)s is calculated: %(count)s things to settle before pay day"
msgstr[0] ""
"Ish haqi hisoblandi (%(month)s): ish haqi kunigacha hal qilinadigan "
"masalalar — %(count)s ta"

#: backend/apps/ai/agents/hr_assistant.py
#, python-format
msgid "Suggested %(count)s bonus for %(month)s: it waits for approval"
msgid_plural ""
"Suggested %(count)s bonuses for %(month)s: they wait for approval"
msgstr[0] ""
"Bonus taklif qilindi (%(month)s): %(count)s ta, tasdiqlash kutilmoqda"

#: backend/apps/ai/agents/morning_plan.py
#, python-format
msgid "Plans for %(count)s person"
msgid_plural "Plans for %(count)s people"
msgstr[0] "%(count)s kishi uchun reja"

#: backend/apps/ai/agents/morning_plan.py backend/apps/groups/models.py
msgid "Morning plan"
msgstr "Ertalabki reja"

#: backend/apps/ai/agents/morning_plan.py
msgid ""
"Each workday morning, every head and manager gets their team's day: what is "
"due, what is late, what waits for their check and who is off."
msgstr ""
"Har ish kuni ertalab har bir rahbar va menejer jamoasining kunini oladi: "
"nima muddatli, nima kechikkan, nima tekshiruvini kutmoqda va kim dam olishda."

#: backend/apps/ai/agents/morning_plan.py
msgid "The morning summary for a manager"
msgstr "Rahbar uchun ertalabki xulosa"

#: backend/apps/ai/agents/morning_plan.py
msgid "Who gets it"
msgstr "Kim oladi"

#: backend/apps/ai/agents/morning_plan.py
msgid "Department heads"
msgstr "Bo‘lim rahbarlari"

#: backend/apps/ai/agents/morning_plan.py
msgid "Managers"
msgstr "Menejerlar"

#: backend/apps/ai/agents/morning_plan.py
msgid "Heads and managers"
msgstr "Rahbarlar va menejerlar"

#: backend/apps/ai/agents/morning_plan.py
msgid "Sends the morning plans"
msgstr "Ertalabki rejalarni yuboradi"

#: backend/apps/ai/agents/morning_plan.py
#, python-format
msgid ""
"Morning plan for %(to)s: %(due_today)s due today, %(late)s late, "
"%(to_check)s to check"
msgstr ""
"Ertalabki reja (%(to)s): bugun muddati — %(due_today)s, kechikkan — "
"%(late)s, tekshirish — %(to_check)s"

#: backend/apps/ai/agents/photo_checker.py
