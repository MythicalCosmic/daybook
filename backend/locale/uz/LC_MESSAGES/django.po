msgstr "Bitta xabar uchun juda uzun: ko‘pi bilan %(limit)d belgi."

#: backend/apps/announcements/services.py
msgid "You can only announce to the branches you manage."
msgstr "Faqat o‘zingiz boshqaradigan filiallarga e’lon yubora olasiz."

#: backend/apps/announcements/services.py
msgid "You don't manage any branch to announce to."
msgstr ""
"Siz birorta ham filialni boshqarmaysiz, shuning uchun e’lon yubora olmaysiz."

