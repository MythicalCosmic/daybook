#: backend/apps/ai/agents/morning_plan.py backend/apps/groups/models.py
msgid "Morning plan"
msgstr "Ertalabki reja"

#: backend/apps/ai/agents/morning_plan.py
msgid ""
"Each workday morning, every head and manager gets their team's day: what is "
"due, what is late, what waits for their check and who is off."
msgstr ""
"Har ish kuni ertalab har bir rahbar va menejer jamoasining kunini oladi: nima"
" muddatli, nima kechikkan, nima tekshiruvini kutmoqda va kim dam olishda."

#: backend/apps/ai/agents/morning_plan.py
msgid "The morning summary for a manager"
msgstr "Rahbar uchun ertalabki xulosa"

#: backend/apps/ai/agents/morning_plan.py
msgid "Who gets it"
msgstr "Kim oladi"

#: backend/apps/ai/agents/morning_plan.py
msgid "Department heads"
msgstr "Bo‘lim rahbarlari"

#: backend/apps/ai/agents/morning_plan.py
msgid "Managers"
msgstr "Menejerlar"

#: backend/apps/ai/agents/morning_plan.py
msgid "Heads and managers"
msgstr "Rahbarlar va menejerlar"

#: backend/apps/ai/agents/morning_plan.py
msgid "Sends the morning plans"
msgstr "Ertalabki rejalarni yuboradi"

#: backend/apps/ai/agents/morning_plan.py
#, python-format
msgid ""
"Morning plan for %(to)s: %(due_today)s due today, %(late)s late, %(to_check)s"
" to check"
msgstr ""
"Ertalabki reja (%(to)s): bugun muddati — %(due_today)s, kechikkan — %(late)s,"
" tekshirish — %(to_check)s"

#: backend/apps/ai/agents/photo_checker.py
msgid "When a routine is finished with a photo"
msgstr "Muntazam vazifa rasm bilan bajarilganda"

#: backend/apps/ai/agents/photo_checker.py
msgid "When a task is finished with a photo"
msgstr "Vazifa rasm bilan bajarilganda"

#: backend/apps/ai/agents/photo_checker.py
msgid "Checks each proof photo as it arrives"
msgstr "Har bir dalil rasmini kelishi bilan tekshiradi"

#: backend/apps/ai/agents/photo_checker.py
msgid "The fridge shows 5 °C, inside 2-8 °C."
msgstr "Muzlatgich 5 °C ko‘rsatmoqda, 2-8 °C oralig‘ida."

#: backend/apps/ai/agents/photo_checker.py
msgid "The photo is a little dark: take a quick look."
msgstr "Rasm biroz qorong‘i: bir ko‘z yugurtirib chiqing."

#: backend/apps/ai/agents/photo_checker.py
msgid "Photo checker"
msgstr "Rasm tekshiruvchi"

#: backend/apps/ai/agents/photo_checker.py
msgid ""
"Reads the proof photo when a task is finished (a fridge thermometer, expiry "
"dates) and leaves a note for whoever checks the work. Sends task photos to "
"Claude."
msgstr ""
"Vazifa bajarilganda tasdiq rasmini o‘qiydi (muzlatgich termometri, yaroqlilik"
" muddatlari) va ishni tekshiradigan odamga izoh qoldiradi. Vazifa rasmlari "
"Claude xizmatiga yuboriladi."

#: backend/apps/ai/agents/photo_checker.py
msgid "Checking a proof photo"
msgstr "Isbot rasmini tekshirish"

#: backend/apps/ai/agents/photo_checker.py
msgid "Only routines"
msgstr "Faqat muntazam vazifalar"

#: backend/apps/ai/agents/photo_checker.py
msgid "Check only the photos of daily routines."
msgstr "Faqat kundalik muntazam vazifalar rasmlarini tekshirish."

#: backend/apps/ai/agents/photo_checker.py
#, python-format
msgid "Photo of «%(task)s» looks right: %(note)s"
msgstr "«%(task)s» rasmi joyida: %(note)s"

#: backend/apps/ai/agents/photo_checker.py
#, python-format
msgid "Photo of «%(task)s» needs a look: %(note)s"
msgstr "«%(task)s» rasmini ko‘rib chiqing: %(note)s"

#: backend/apps/ai/agents/photo_checker.py
#, python-format
msgid "Photo of «%(task)s» doesn't show enough: %(note)s"
msgstr "«%(task)s» rasmida yetarli narsa ko‘rinmaydi: %(note)s"

#: backend/apps/ai/agents/registry.py
