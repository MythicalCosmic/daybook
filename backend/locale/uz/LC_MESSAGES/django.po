msgstr "Taklif havolalari yangilandi. Eski havolalar endi ishlamaydi."

#: backend/apps/companies/models.py
#, python-format
msgid "Unknown timezone: %(value)s"
msgstr "Noma’lum vaqt mintaqasi: %(value)s"

#: backend/apps/companies/models.py
msgid "How long a rejected person waits before asking to join again."
msgstr "Rad etilgan odam qayta so‘rov yuborishdan oldin qancha kutadi."

#: backend/apps/companies/models.py
msgid "When groups get today's plan, in the company's timezone."
msgstr "Guruhlar bugungi rejani qachon oladi (kompaniya vaqt mintaqasida)."

#: backend/apps/companies/models.py
msgid "When groups get the end-of-day summary."
msgstr "Guruhlar kun yakunini qachon oladi."

#: backend/apps/companies/models.py
msgid "At the morning report time, everyone gets their tasks for the day from the bot."
msgstr "Ertalabki hisobot vaqtida har kim botdan o‘sha kungi vazifalarini oladi."

#: backend/apps/companies/services.py
msgid "This invite link is invalid or has expired. Ask your manager for a new one."
msgstr "Bu taklif havolasi noto‘g‘ri yoki eskirgan. Rahbaringizdan yangisini so‘rang."

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "✅ <b>%(name)s</b> finished <b>%(task)s</b>"
msgstr "✅ <b>%(name)s</b> <b>%(task)s</b> vazifasini bajardi"

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "At %(time)s, on time."
msgstr "Soat %(time)s da, o‘z vaqtida."

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "At %(time)s, %(late)s late."
msgstr "Soat %(time)s da, %(late)s kechikib."

#: backend/apps/groups/bot_messages.py
msgid "Waiting for a check."
msgstr "Tekshiruv kutilmoqda."

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "🚨 <b>%(name)s</b> is %(late)s late with <b>%(task)s</b>."
msgstr "🚨 <b>%(name)s</b> <b>%(task)s</b> vazifasini %(late)s kechiktirmoqda."

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "👋 <b>%(name)s</b> joined the team as %(position)s."
msgstr "👋 <b>%(name)s</b> jamoaga %(position)s sifatida qo‘shildi."

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "👋 <b>%(name)s</b> joined the team."
msgstr "👋 <b>%(name)s</b> jamoaga qo‘shildi."

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "🌅 <b>Today's plan</b> · %(date)s"
msgstr "🌅 <b>Bugungi reja</b> · %(date)s"

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "• %(name)s: %(count)d, the first at %(time)s"
msgstr "• %(name)s: %(count)d ta, birinchisi soat %(time)s da"

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "🌙 <b>How today went</b> · %(date)s"
msgstr "🌙 <b>Kun qanday o‘tdi</b> · %(date)s"

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "✅ Done on time: %(count)d"
msgstr "✅ O‘z vaqtida bajarildi: %(count)d"

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "⏰ Done late: %(count)d"
msgstr "⏰ Kechikib bajarildi: %(count)d"

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "❌ Not done: %(count)d"
msgstr "❌ Bajarilmadi: %(count)d"

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "🔗 This group is now connected to <b>%(company)s</b>."
msgstr "🔗 Bu guruh endi <b>%(company)s</b> kompaniyasiga ulandi."

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "👥 Whose news: %(who)s"
msgstr "👥 Kimning yangiliklari: %(who)s"

#: backend/apps/groups/bot_messages.py
msgid "✔️ Done"
msgstr "✔️ Tayyor"

#: backend/apps/groups/bot_messages.py
msgid "⚙️ <b>What should I post here?</b> Tap to turn things on or off."
msgstr "⚙️ <b>Bu yerga nimalarni yozay?</b> Yoqish yoki o‘chirish uchun bosing."

#: backend/apps/groups/bot_messages.py
msgid "⬅️ Back"
msgstr "⬅️ Orqaga"

#: backend/apps/groups/bot_messages.py
msgid ""
"👥 <b>Whose news should this group get?</b> Pick positions, or leave them all off for everyone."
msgstr ""
"👥 <b>Bu guruh kimlarning yangiliklarini olsin?</b> Lavozimlarni tanlang yoki hamma uchun "
"birortasini ham belgilamang."

#: backend/apps/groups/bot_messages.py
msgid "This company has no positions yet."
msgstr "Bu kompaniyada hali lavozimlar yo‘q."

#: backend/apps/groups/bot_messages.py
msgid "everyone"
msgstr "hamma"

#: backend/apps/groups/bot_messages.py
msgid ""
"👋 Hi! I post this team's task news here: finished work, late tasks and daily summaries.\n"
"A manager can link me to the company by sending /connect."
msgstr ""
"👋 Salom! Men bu yerga jamoaning vazifalar bo‘yicha yangiliklarini yozaman: bajarilgan ishlar, kechikkan vazifalar va kunlik hisobotlar.\n"
"Rahbar /connect yuborib, meni kompaniyaga ulashi mumkin."

#: backend/apps/groups/bot_messages.py
msgid "This group isn't connected to a company yet. A manager can send /connect."
msgstr "Bu guruh hali kompaniyaga ulanmagan. Rahbar /connect yuborishi mumkin."

#: backend/apps/groups/bot_messages.py
msgid ""
"I can't tell who you are while you post anonymously. Turn off “Remain anonymous” in your admin "
"rights and try again."
msgstr ""
"Anonim yozayotganingizda kimligingizni bila olmayman. Admin huquqlaringizda “Anonim qolish”ni "
"o‘chirib, qayta urinib ko‘ring."

#: backend/apps/groups/bot_messages.py
msgid ""
"🔌 Disconnected. I won't post here any more. A manager can send /connect to link this group again."
msgstr ""
"🔌 Uzildi. Endi bu yerga yozmayman. Rahbar guruhni qayta ulash uchun /connect yuborishi mumkin."

#: backend/apps/groups/bot_messages.py
msgid "Nothing will be posted here. Send /settings to change that."
msgstr "Bu yerga hech narsa yozilmaydi. O‘zgartirish uchun /settings yuboring."

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "I'll post here: %(events)s."
msgstr "Bu yerga yozaman: %(events)s."

#: backend/apps/groups/bot_messages.py
#, python-format
msgid "Only about: %(positions)s."
msgstr "Faqat %(positions)s haqida."

#: backend/apps/groups/bot_messages.py
msgid "Send /settings to change that."
msgstr "O‘zgartirish uchun /settings yuboring."

#: backend/apps/groups/forms.py
msgid "Pick positions from this group's company."
msgstr "Lavozimlarni shu guruhning kompaniyasidan tanlang."

#: backend/apps/groups/models.py
msgid "Daily tasks done"
msgstr "Bajarilgan kundalik vazifalar"

#: backend/apps/groups/models.py
msgid "Assigned tasks done"
msgstr "Bajarilgan topshiriqlar"

#: backend/apps/groups/models.py
msgid "Late tasks"
msgstr "Kechikkan vazifalar"

#: backend/apps/groups/models.py
msgid "New people"
msgstr "Yangi xodimlar"

#: backend/apps/groups/models.py
msgid "Morning plan"
msgstr "Ertalabki reja"

#: backend/apps/groups/models.py
msgid "End-of-day summary"
msgstr "Kun yakuni"

#: backend/apps/groups/models.py
msgid "Only news about people in these positions. None = everyone."
msgstr "Faqat shu lavozimlardagi odamlar haqidagi yangiliklar. Bo‘sh = hamma."

#: backend/apps/groups/models.py
msgid "Off once the bot is removed or the group is disconnected."
msgstr "Bot chiqarilsa yoki guruh uzilsa, o‘chadi."

#: backend/apps/groups/services.py
msgid "Only a company manager can connect this group. Ask one to send /connect here."
msgstr ""
"Bu guruhni faqat kompaniya rahbari ulay oladi. Rahbardan bu yerda /connect yuborishini so‘rang."

#: backend/apps/groups/services.py
msgid "This group is already connected to another company."
msgstr "Bu guruh allaqachon boshqa kompaniyaga ulangan."

#: backend/apps/groups/services.py
msgid "Only a manager of this company can change that."
msgstr "Buni faqat shu kompaniya rahbari o‘zgartira oladi."

#: backend/apps/groups/services.py
msgid "That position no longer exists."
msgstr "Bu lavozim endi mavjud emas."

