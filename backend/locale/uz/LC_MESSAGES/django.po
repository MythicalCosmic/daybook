#: backend/apps/signin/bot_messages.py
msgid "Sign in to the dashboard?"
msgstr "Boshqaruv paneliga kirasizmi?"

#: backend/apps/signin/bot_messages.py
msgid "Tap the number you see on your screen."
msgstr "Ekraningizda ko‘rinib turgan raqamni bosing."

#: backend/apps/signin/bot_messages.py
msgid "Didn't start this? Tap “It wasn't me”."
msgstr "Kirishni siz boshlamadingizmi? «Bu men emasman» tugmasini bosing."

#: backend/apps/signin/bot_messages.py
msgid "It wasn't me"
msgstr "Bu men emasman"

#: backend/apps/signin/bot_messages.py
msgid "This sign-in code has expired. Get a new one in your browser."
msgstr "Bu kirish kodining muddati tugadi. Brauzerda yangisini oling."

