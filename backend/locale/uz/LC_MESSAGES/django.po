msgstr "%(time)s dan keyin qayta so‘rov yuborishingiz mumkin."

#: backend/apps/members/bot_messages.py
msgid "You can ask again by opening the invite link."
msgstr "Taklif havolasini ochib, qayta so‘rov yuborishingiz mumkin."

#: backend/apps/members/bot_messages.py backend/apps/timeoff/bot_messages.py
#, python-format
