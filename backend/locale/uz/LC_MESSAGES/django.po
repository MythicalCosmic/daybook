msgstr "Yoqing yoki o‘chiring."

#: backend/apps/ai/agents/registry.py
msgid "Enter a whole number."
msgstr "Butun son kiriting."

#: backend/apps/ai/agents/registry.py
#, python-format
msgid "At least %(min)s."
msgstr "Kamida %(min)s."

#: backend/apps/ai/agents/registry.py
