msgid "Read"
msgstr "O‘qilgan"

#: backend/apps/announcements/bot_messages.py
msgid ""
"📣 Send the announcement as one message. Bold, italics and links are kept."
msgstr ""
"📣 E’lonni bitta xabar qilib yuboring. Qalin, kursiv matn va havolalar "
"saqlanadi."

#: backend/apps/announcements/bot_messages.py
msgid "📤 Send to the chosen positions"
msgstr "📤 Tanlangan lavozimlarga yuborish"

#: backend/apps/announcements/bot_messages.py
msgid "📤 Send to everyone"
msgstr "📤 Hammaga yuborish"

#: backend/apps/announcements/bot_messages.py
msgid "Who should get it? Tap positions, or send it to everyone."
msgstr "Kimlar olsin? Lavozimlarni tanlang yoki hammaga yuboring."

