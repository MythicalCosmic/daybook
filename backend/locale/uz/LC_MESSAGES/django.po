msgid "%(person)s can't receive cash now."
msgstr "%(person)s hozir naqd pul qabul qila olmaydi."

#: backend/apps/sales/services.py
msgid "You can't hand cash over to yourself."
msgstr "Naqd pulni o‘zingizga topshira olmaysiz."

#: backend/apps/sales/services.py
msgid "This isn't a handover."
msgstr "Bu pul topshirish emas."

#: backend/apps/sales/services.py employee_bot/bot/handlers/features/sales.py
msgid "Only the person receiving the cash can answer this."
msgstr "Bunga faqat naqd pulni qabul qilayotgan odam javob bera oladi."

#: backend/apps/sales/services.py
msgid "This handover was cancelled."
msgstr "Bu pul topshirish bekor qilingan."

#: backend/apps/sales/services.py
msgid "This has already been answered."
msgstr "Bunga allaqachon javob berilgan."

#: backend/apps/sales/services.py
msgid "This movement is already void."
msgstr "Bu kassa operatsiyasi allaqachon bekor qilingan."

#: backend/apps/sales/services.py
msgid "Pick sale or refund."
msgstr "Savdo yoki qaytarishni tanlang."

#: backend/apps/sales/services.py
msgid "Add how the customer paid."
msgstr "Mijoz qanday to‘laganini ko‘rsating."

#: backend/apps/sales/services.py
#, python-format
msgid "%(method)s is switched off."
msgstr "«%(method)s» to‘lov usuli o‘chirilgan."

#: backend/apps/sales/services.py
#, python-format
msgid "%(branch)s has no till yet."
msgstr "%(branch)s filialida hali kassa yo‘q."

#: backend/apps/sales/services.py
msgid "That till is in another branch."
msgstr "Bu kassa boshqa filialda."

#: backend/apps/sales/services.py
msgid ""
"Imported receipts come from the cash-register program: correct them there."
msgstr ""
"Import qilingan cheklar kassa dasturidan keladi: ularni o‘sha yerda tuzating."

#: backend/apps/sales/services.py
msgid "This receipt is already void."
msgstr "Bu chek allaqachon bekor qilingan."

#: backend/apps/sales/services.py
#, python-format
msgid ""
"This receipt is part of the closed shift %(shift)s: correct the shift "
"instead."
msgstr ""
"Bu chek yopilgan %(shift)s smenasiga tegishli: buning o‘rniga smenani "
"tuzating."

#: backend/apps/sales/services.py
msgid "Give the profile a name, e.g. the cash-register program's."
msgstr "Profilga nom bering, masalan, kassa dasturining nomi."

#: backend/apps/sales/services.py
#, python-format
msgid "There is already a profile called %(name)s."
msgstr "Bunday nomli profil allaqachon bor: %(name)s."

#: backend/apps/sales/services.py
msgid "Pick CSV or Excel."
msgstr "CSV yoki Excel ni tanlang."

#: backend/apps/sales/services.py
msgid "Pick the file's encoding."
msgstr "Fayl kodlashini tanlang."

#: backend/apps/sales/services.py
msgid "The delimiter is one character, like ; or ,"
msgstr "Ajratgich bitta belgi, masalan ; yoki ,"

#: backend/apps/sales/services.py
msgid "The header row is a number."
msgstr "Sarlavha qatori son bo‘lishi kerak."

#: backend/apps/sales/services.py
msgid "The header row is between 1 and 50."
msgstr "Sarlavha qatorining raqami: 1–50."

#: backend/apps/sales/services.py
msgid "A date format looks like \"%d.%m.%Y %H:%M\"."
msgstr "Sana formati shunday ko‘rinadi: «%d.%m.%Y %H:%M»."

#: backend/apps/sales/services.py
msgid "Pick packs or parts."
msgstr "Qadoq yoki qismni tanlang."

#: backend/apps/sales/services.py
msgid "The branch map isn't readable."
msgstr "Filiallar xaritasini o‘qib bo‘lmadi."

#: backend/apps/sales/services.py
msgid "The branch map names a branch of another company."
msgstr "Filiallar xaritasida boshqa kompaniyaning filiali bor."

#: backend/apps/sales/services.py
msgid "The column map isn't readable."
msgstr "Ustunlar xaritasini o‘qib bo‘lmadi."

#: backend/apps/sales/services.py
msgid "Turn on imported sale lines in the sales settings first."
msgstr "Avval savdo sozlamalarida savdo qatorlari importini yoqing."

#: backend/apps/sales/services.py
msgid "This profile is archived."
msgstr "Bu profil arxivda."

#: backend/apps/sales/services.py
#, python-format
msgid "%(profile)s reads %(kind)s files."
msgstr "%(profile)s faqat shu fayllarni o‘qiydi: %(kind)s."

#: backend/apps/sales/services.py
msgid "Pick a code."
msgstr "Kodni tanlang."

#: backend/apps/sales/services.py
#, python-format
msgid "%(person)s isn't on the team now."
msgstr "%(person)s hozir jamoada emas."

#: backend/apps/sales/services.py
msgid "Pick what kind of customer this is."
msgstr "Mijoz turini tanlang."

#: backend/apps/sales/services.py
#, python-format
msgid "%(name)s isn't a customer."
msgstr "%(name)s mijoz emas."

#: backend/apps/sales/services.py
#, python-format
msgid "%(name)s is archived."
msgstr "%(name)s arxivda."

#: backend/apps/sales/services.py
msgid "Pick a credit sale or a payment."
msgstr "Qarzga sotuv yoki to‘lovni tanlang."

#: backend/apps/sales/services.py
#, python-format
msgid "%(name)s may not take nasiya now."
msgstr "%(name)s hozir nasiya ololmaydi."

#: backend/apps/sales/services.py
#, python-format
msgid "That goes over %(name)s's limit: %(left)s owed of %(limit)s."
msgstr "Bu limitdan oshadi: %(name)s, qarzi %(left)s, limit %(limit)s."

#: backend/apps/sales/services.py
#, python-format
msgid "%(name)s owes nothing."
msgstr "%(name)s qarzdor emas."

#: backend/apps/sales/services.py
#, python-format
msgid "That's more than the %(left)s %(name)s owes."
msgstr "Bu qarzdan ko‘p: %(name)s, qarzi %(left)s."

#: backend/apps/sales/services.py
msgid "Nasiya can't be paid back with nasiya."
msgstr "Nasiyani nasiya bilan to‘lab bo‘lmaydi."

#: backend/apps/sales/services.py
#, python-format
msgid "Nasiya, %(shift)s"
msgstr "Nasiya, %(shift)s"

#: backend/apps/sales/services.py
msgid "This entry is already void."
msgstr "Bu yozuv allaqachon bekor qilingan."

#: backend/apps/sales/services.py
#, python-format
msgid "This entry is part of the closed shift %(shift)s."
msgstr "Bu yozuv yopilgan smenaga tegishli: %(shift)s."

#: backend/apps/sales/services.py
msgid "Part of this nasiya was already paid back."
msgstr "Bu nasiyaning bir qismi allaqachon to‘langan."

#: backend/apps/sales/services.py
#, python-format
msgid ""
"Nasiya on the Z-report is %(typed)s, but %(recorded)s was recorded as credit "
"sales in this shift (a gap of %(gap)s). Record the missing credit sales with "
"their customers, or correct the total."
msgstr ""
"Z-hisobotdagi nasiya: %(typed)s, bu smenada qarzga sotuv sifatida yozilgani: "
"%(recorded)s (farqi %(gap)s). Yetishmagan qarzga sotuvlarni mijozlari bilan "
"yozing yoki summani tuzating."

#: backend/apps/sales/services.py
msgid "Add at least one line."
msgstr "Kamida bitta qator qo‘shing."

#: backend/apps/sales/services.py
msgid "An invoice holds at most 300 lines."
msgstr "Hisob-fakturada ko‘pi bilan 300 ta qator bo‘ladi."

#: backend/apps/sales/services.py
msgid "Pick medicines of this company's catalogue."
msgstr "Shu kompaniya katalogidagi dorilarni tanlang."

#: backend/apps/sales/services.py
#, python-format
msgid "Line %(n)s needs a name."
msgstr "Qatorga nom kerak (qator: %(n)s)."

#: backend/apps/sales/services.py
#, python-format
msgid "Line %(n)s needs a quantity."
msgstr "Qatorga miqdor kerak (qator: %(n)s)."

#: backend/apps/sales/services.py
#, python-format
msgid "Line %(n)s has a discount above its amount."
msgstr "Qatordagi chegirma summadan katta (qator: %(n)s)."

#: backend/apps/sales/services.py
msgid "Pick the invoice's currency."
msgstr "Hisob-faktura valyutasini tanlang."

#: backend/apps/sales/services.py
msgid "Only a draft can be changed."
msgstr "Faqat qoralamani o‘zgartirish mumkin."

#: backend/apps/sales/services.py
msgid "This invoice is already issued."
msgstr "Bu hisob-faktura allaqachon chiqarilgan."

#: backend/apps/sales/services.py
msgid "Add lines with a price before issuing."
msgstr "Chiqarishdan oldin narxli qatorlar qo‘shing."

#: backend/apps/sales/services.py
msgid "Pick the warehouse or pharmacy the goods leave from."
msgstr "Tovar qaysi ombor yoki dorixonadan chiqishini tanlang."

#: backend/apps/sales/services.py
msgid "Only an issued invoice takes payments."
msgstr "Faqat chiqarilgan hisob-fakturaga to‘lov qabul qilinadi."

#: backend/apps/sales/services.py
msgid "This invoice is already void."
msgstr "Bu hisob-faktura allaqachon bekor qilingan."

#: backend/apps/sales/services.py
msgid "A payment was made on this invoice: it can't be voided."
msgstr "Bu hisob-faktura bo‘yicha to‘lov qilingan: uni bekor qilib bo‘lmaydi."

#: backend/apps/sales/services.py
msgid "Issue the invoice before sending it."
msgstr "Yuborishdan oldin hisob-fakturani chiqaring."

#: backend/apps/sales/services.py
#, python-format
msgid "Invoice %(number)s from %(company)s"
msgstr "Hisob-faktura %(number)s, %(company)s"

