#: backend/apps/accounts/admin.py
msgid "Telegram"
msgstr "Telegram"

#: backend/apps/accounts/models.py
msgid "Only set from a contact the person shared in Telegram."
msgstr "Faqat odam Telegram’da ulashgan kontaktdan olinadi."

#: backend/apps/accounts/models.py
msgid "When Telegram said this person blocked the employee bot."
msgstr "Telegram bu odam xodimlar botini bloklaganini bildirgan vaqt."

#: backend/apps/announcements/admin.py
msgid "Read"
msgstr "O‘qilgan"

#: backend/apps/announcements/bot_messages.py
msgid "📣 Send the announcement as one message. Bold, italics and links are kept."
msgstr "📣 E’lonni bitta xabar qilib yuboring. Qalin, kursiv matn va havolalar saqlanadi."

#: backend/apps/announcements/bot_messages.py
msgid "📤 Send to the chosen positions"
msgstr "📤 Tanlangan lavozimlarga yuborish"

#: backend/apps/announcements/bot_messages.py
msgid "📤 Send to everyone"
msgstr "📤 Hammaga yuborish"

#: backend/apps/announcements/bot_messages.py
msgid "Who should get it? Tap positions, or send it to everyone."
msgstr "Kimlar olsin? Lavozimlarni tanlang yoki hammaga yuboring."

#: backend/apps/announcements/bot_messages.py
msgid "📣 <b>Preview</b>"
msgstr "📣 <b>Oldindan ko‘rish</b>"

#: backend/apps/announcements/bot_messages.py
#, python-format
msgid "📣 Sent. Recipients: %(count)d. Tap below to see who has read it."
msgstr ""
"📣 Yuborildi. Qabul qiluvchilar: %(count)d ta. Kim o‘qiganini ko‘rish uchun pastdagi tugmani "
"bosing."

#: backend/apps/announcements/bot_messages.py
#, python-format
msgid "📣 <b>Reminder</b>: please read this announcement from %(name)s."
msgstr "📣 <b>Eslatma</b>: iltimos, %(name)s yuborgan e’lonni o‘qing."

#: backend/apps/announcements/bot_messages.py
#, python-format
msgid "📣 <b>Announcement</b> · %(name)s"
msgstr "📣 <b>E’lon</b> · %(name)s"

#: backend/apps/announcements/bot_messages.py
msgid "✅ I've read it"
msgstr "✅ O‘qidim"

#: backend/apps/announcements/bot_messages.py
msgid "✅ You have read this."
msgstr "✅ Siz buni o‘qidingiz."

#: backend/apps/announcements/bot_messages.py
#, python-format
msgid "📣 Read by %(read)d of %(total)d."
msgstr "📣 %(total)d kishidan %(read)d tasi o‘qidi."

#: backend/apps/announcements/bot_messages.py
#, python-format
msgid "Not yet: %(names)s"
msgstr "Hali o‘qimaganlar: %(names)s"

#: backend/apps/announcements/bot_messages.py
#, python-format
msgid ""
"📣 A day later, %(unread)d of %(total)d people still haven't read your announcement “%(title)s”: "
"%(names)s"
msgstr ""
"📣 Bir kun o‘tdi, lekin %(total)d kishidan %(unread)d tasi hali “%(title)s” e’loningizni o‘qimadi: "
"%(names)s"

#: backend/apps/announcements/bot_messages.py backend/apps/groups/bot_messages.py
#: backend/apps/reports/bot_messages.py
#, python-format
msgid "…and %(count)d more"
msgstr "…va yana %(count)d ta"

#: backend/apps/announcements/bot_messages.py
msgid "👀 Who has read it?"
msgstr "👀 Kim o‘qidi?"

#: backend/apps/announcements/bot_messages.py backend/apps/tasks/bot_messages.py
msgid "✖️ Cancel"
msgstr "✖️ Bekor qilish"

#: backend/apps/announcements/models.py
msgid "As the author wrote it, formatting included."
msgstr "Muallif yozganidek, formatlash bilan."

#: backend/apps/announcements/models.py
msgid "Who gets it. None = everyone."
msgstr "Kim oladi. Bo‘sh = hamma."

#: backend/apps/announcements/models.py
msgid "When the author heard who still hadn't read it."
msgstr "Muallifga kim hali o‘qimagani aytilgan vaqt."

#: backend/apps/announcements/services.py employee_bot/bot/handlers/member/announcements.py
msgid "Only managers can send announcements."
msgstr "E’lonni faqat rahbarlar yubora oladi."

#: backend/apps/announcements/services.py
msgid "Write something to send."
msgstr "Yuborish uchun nimadir yozing."

#: backend/apps/announcements/services.py employee_bot/bot/handlers/member/announcements.py
#, python-format
msgid "That's too long for one message: %(limit)d characters at most."
msgstr "Bitta xabar uchun juda uzun: ko‘pi bilan %(limit)d belgi."

#: backend/apps/announcements/services.py
msgid "This announcement no longer exists."
msgstr "Bu e’lon endi mavjud emas."

