msgstr "Kompaniya vaqt mintaqasida."

#: backend/apps/tasks/models.py
msgid "No tasks are made for days before this."
msgstr "Bundan oldingi kunlar uchun vazifa yaratilmaydi."

#: backend/apps/tasks/models.py
msgid "Everyone holding one of these positions gets the task."
msgstr "Shu lavozimlardan birida ishlaydigan har bir xodim vazifani oladi."

#: backend/apps/tasks/models.py
msgid "Made by an employee for themselves; it repeats a personal task."
msgstr "Xodim o‘zi uchun yaratgan; shaxsiy vazifani takrorlaydi."

#: backend/apps/tasks/models.py
msgid "Leave empty for the company's default."
msgstr "Kompaniyaning asosiy sozlamasi uchun bo‘sh qoldiring."

#: backend/apps/tasks/models.py
msgid "Who hears when it's late. Empty: everyone who can confirm tasks."
msgstr ""
"Kechiksa, kim xabar oladi. Bo‘sh: vazifalarni qabul qila oladigan hamma."

#: backend/apps/tasks/models.py
msgid "Daily"
msgstr "Kundalik"

#: backend/apps/tasks/models.py
msgid "Assigned"
msgstr "Topshiriq"

#: backend/apps/tasks/models.py
msgid "Personal"
msgstr "Shaxsiy"

#: backend/apps/tasks/models.py
msgid "To do"
msgstr "Bajarish kerak"

#: backend/apps/tasks/models.py
msgid "In progress"
msgstr "Jarayonda"

#: backend/apps/tasks/models.py
msgid "Waiting for confirmation"
msgstr "Tekshirilmoqda"

#: backend/apps/tasks/models.py
msgid "Sent back"
msgstr "Qaytarildi"

#: backend/apps/tasks/models.py
msgid "Urgent"
msgstr "Shoshilinch"

#: backend/apps/tasks/models.py
msgid "For daily tasks: the local day it belongs to."
msgstr "Kundalik vazifalar uchun: u tegishli bo‘lgan mahalliy kun."

#: backend/apps/tasks/models.py
msgid "The assignee's home branch when the task was made; never moves after."
msgstr ""
"Vazifa yaratilgan paytdagi ijrochining asosiy filiali; keyin o‘zgarmaydi."

#: backend/apps/tasks/models.py
msgid "Gave you a task"
msgstr "Sizga vazifa berdi"

#: backend/apps/tasks/models.py
msgid "Asked you to check a task"
msgstr "Vazifani tekshirishingizni so‘radi"

#: backend/apps/tasks/models.py
msgid "Completed a task you gave"
msgstr "Siz bergan vazifani bajardi"

#: backend/apps/tasks/models.py
msgid "Checked your task"
msgstr "Vazifangizni tekshirdi"

#: backend/apps/tasks/models.py
msgid "Commented on a task"
msgstr "Vazifaga izoh qoldirdi"

#: backend/apps/tasks/services.py
msgid "You can't assign tasks to others."
msgstr "Siz boshqalarga vazifa bera olmaysiz."

#: backend/apps/tasks/services.py
msgid "Tasks can only go to registered members of your company."
msgstr ""
"Vazifani faqat kompaniyangizning ro‘yxatdan o‘tgan xodimlariga berish mumkin."

#: backend/apps/tasks/services.py
msgid "Repeating tasks for others are set up as daily tasks."
msgstr ""
"Boshqalar uchun takrorlanuvchi vazifalar kundalik vazifa sifatida sozlanadi."

#: backend/apps/tasks/services.py
msgid "Pick a time for a repeating task."
msgstr "Takrorlanuvchi vazifa uchun vaqt tanlang."

#: backend/apps/tasks/services.py
msgid "You can't change this task."
msgstr "Bu vazifani o‘zgartira olmaysiz."

#: backend/apps/tasks/services.py
msgid "Only open tasks can be changed."
msgstr "Faqat ochiq vazifalarni o‘zgartirish mumkin."

#: backend/apps/tasks/services.py
msgid "This task has already been started."
msgstr "Bu vazifa allaqachon boshlangan."

#: backend/apps/tasks/services.py
msgid "Say what needs to be fixed."
msgstr "Nimani tuzatish kerakligini yozing."

#: backend/apps/tasks/services.py
msgid "You can't cancel this task."
msgstr "Bu vazifani bekor qila olmaysiz."

#: backend/apps/tasks/services.py
msgid "Only open tasks with a deadline can be snoozed."
msgstr "Faqat muddati bor ochiq vazifalarni keyinga surish mumkin."

#: backend/apps/tasks/services.py
msgid "No snoozes left for this task."
msgstr "Bu vazifani boshqa keyinga surib bo‘lmaydi."

#: backend/apps/tasks/services.py
msgid "A comment can't be empty."
msgstr "Izoh bo‘sh bo‘lmasligi kerak."

#: backend/apps/tasks/services.py
msgid "Give the task a title."
msgstr "Vazifaga nom bering."

#: backend/apps/tasks/services.py
msgid "The deadline must be in the future."
msgstr "Muddat kelajakda bo‘lishi kerak."

#: backend/apps/tasks/services.py
msgid "Attach a photo to complete this task."
msgstr "Vazifani yakunlash uchun rasm biriktiring."

#: backend/apps/tasks/services.py
msgid "Write a short report to complete this task."
msgstr "Vazifani yakunlash uchun qisqa hisobot yozing."

#: backend/apps/tasks/services.py
msgid "Attach a photo or write a short report to complete this task."
msgstr "Vazifani yakunlash uchun rasm biriktiring yoki qisqa hisobot yozing."

#: backend/apps/tasks/services.py
#, python-format
msgid "This task is already %(status)s."
msgstr "Bu vazifa allaqachon “%(status)s” holatida."

#: backend/apps/tasks/services.py
msgid "Only the person this task is for can do that."
msgstr "Buni faqat vazifa berilgan odam qila oladi."

#: backend/apps/tasks/services.py
msgid "You can't confirm this task."
msgstr "Bu vazifani qabul qila olmaysiz."

#: backend/apps/tasks/services.py
msgid "This task isn't waiting for confirmation."
msgstr "Bu vazifa tekshiruvni kutmayapti."

#: backend/apps/tasks/services.py backend/apps/timeoff/services.py
msgid "Finish registration first."
msgstr "Avval ro‘yxatdan o‘tishni yakunlang."

#: backend/apps/timeoff/admin.py
msgid "Approve selected time off"
msgstr "Tanlangan dam olishlarni tasdiqlash"

#: backend/apps/timeoff/admin.py
msgid "Reject selected time off"
msgstr "Tanlangan dam olishlarni rad etish"

#: backend/apps/timeoff/admin.py
#, python-format
msgid "Decided: %(count)d"
msgstr "Qaror qabul qilindi: %(count)d"

#: backend/apps/timeoff/bot_messages.py
#, python-format
msgid "🌴 <b>Time off request</b> · %(name)s"
msgstr "🌴 <b>Dam olish so‘rovi</b> · %(name)s"

#: backend/apps/timeoff/bot_messages.py
#, python-format
msgid "📅 %(dates)s · days: %(count)d"
msgstr "📅 %(dates)s · %(count)d kun"

#: backend/apps/timeoff/bot_messages.py
#, python-format
msgid "Reason: %(reason)s"
msgstr "Sabab: %(reason)s"

#: backend/apps/timeoff/bot_messages.py
#, python-format
msgid ""
"🌴 Your time off is approved: %(dates)s. No tasks or reminders from me on "
"those days. Have a good rest!"
msgstr ""
"🌴 Dam olish kunlaringiz tasdiqlandi: %(dates)s. Bu kunlarda sizga vazifa "
"ham, eslatma ham yubormayman. Yaxshi dam oling!"

#: backend/apps/timeoff/bot_messages.py
#, python-format
msgid "Your time off request for %(dates)s was declined."
msgstr "%(dates)s uchun dam olish so‘rovingiz rad etildi."

#: backend/apps/timeoff/bot_messages.py
#, python-format
msgid "🚫 Cancelled by %(name)s"
msgstr "🚫 %(name)s bekor qildi"

#: backend/apps/timeoff/models.py
msgid "Someone who recorded it on the person's behalf."
msgstr "Dam olishni xodim nomidan qayd etgan kishi."

#: backend/apps/timeoff/services.py
msgid "The last day can't be before the first one."
msgstr "Oxirgi kun birinchi kundan oldin bo‘lishi mumkin emas."

#: backend/apps/timeoff/services.py
msgid "Time off can't start in the past."
msgstr "Dam olish o‘tgan kundan boshlana olmaydi."

#: backend/apps/timeoff/services.py
#, python-format
msgid "Ask for at most %(days)d days at a time."
msgstr "Bir martada ko‘pi bilan %(days)d kun so‘rash mumkin."

#: backend/apps/timeoff/services.py
msgid "You've already asked for some of these days."
msgstr "Bu kunlarning ba’zilarini allaqachon so‘ragansiz."

#: backend/apps/timeoff/services.py
msgid "Someone else has to decide on your own time off."
msgstr "O‘z dam olishingiz bo‘yicha boshqa odam qaror qilishi kerak."

#: backend/apps/timeoff/services.py
msgid "Only the person who asked can cancel this."
msgstr "Buni faqat so‘ragan odam bekor qila oladi."

#: backend/apps/timeoff/services.py
msgid "Time off that has already started can't be cancelled."
msgstr "Boshlangan dam olishni bekor qilib bo‘lmaydi."

