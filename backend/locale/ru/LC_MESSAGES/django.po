#, python-format
msgid "A plan has at most %(n)s instalments."
msgstr "Платежей в графике может быть не больше %(n)s."

#: backend/apps/finance/services.py
msgid "An instalment can't be due before the day the debt was issued."
msgstr "Срок платежа по графику не может быть раньше даты возникновения долга."

#: backend/apps/finance/services.py
#, python-format
msgid "The instalments add up to %(total)s; the debt is %(amount)s."
msgstr "Платежи по графику в сумме дают %(total)s, а долг — %(amount)s."

