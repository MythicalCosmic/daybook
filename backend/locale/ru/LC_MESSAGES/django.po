msgid "📣 <b>Preview</b>"
msgstr "📣 <b>Предпросмотр</b>"

#: backend/apps/announcements/bot_messages.py
#, python-format
msgid "📣 Sent. Recipients: %(count)d. Tap below to see who has read it."
msgstr ""
"📣 Отправлено. Получателей: %(count)d. Нажмите ниже, чтобы увидеть, кто "
"прочитал."

#: backend/apps/announcements/bot_messages.py
#, python-format
msgid "📣 <b>Reminder</b>: please read this announcement from %(name)s."
msgstr "📣 <b>Напоминание</b>: пожалуйста, прочитайте объявление от %(name)s."

#: backend/apps/announcements/bot_messages.py
#, python-format
msgid "📣 <b>Announcement</b> · %(name)s"
msgstr "📣 <b>Объявление</b> · %(name)s"

