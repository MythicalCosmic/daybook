#: backend/apps/tasks/bot_messages.py
#, python-format
msgid "<b>To check</b>: %(count)d"
msgstr "<b>На проверку</b>: %(count)d"

#: backend/apps/tasks/bot_messages.py
msgid "Tap one to see it, then confirm it or send it back."
msgstr "Нажмите, чтобы посмотреть, затем примите или верните."

#: backend/apps/tasks/bot_messages.py
