msgid "Taken under a row lock when an invoice is issued."
msgstr "Берётся под блокировкой при выставлении счёта."

#: backend/apps/sales/models.py
msgid "An invoice is due this many days after it is issued."
msgstr "Счёт нужно оплатить через столько дней после выставления."

