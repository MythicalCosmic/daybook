#: backend/apps/announcements/admin.py
msgid "Read"
msgstr "Прочитано"

#: backend/apps/announcements/bot_messages.py
msgid ""
"📣 Send the announcement as one message. Bold, italics and links are kept."
msgstr ""
"📣 Пришлите объявление одним сообщением. Жирный текст, курсив и ссылки "
"сохранятся."

