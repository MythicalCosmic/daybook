msgstr "↩️ Задача снова открыта."

#: employee_bot/bot/handlers/member/tasks.py
msgid "📷 No task is waiting for a photo right now."
msgstr "📷 Сейчас ни одна задача не ждёт фото."

#: employee_bot/bot/handlers/member/tasks.py
msgid "👌 Okay, no task."
msgstr "👌 Хорошо, без задачи."

#: employee_bot/bot/handlers/member/tasks.py
msgid "Send the photo again, please."
msgstr "Пожалуйста, пришлите фото ещё раз."

#: employee_bot/bot/handlers/member/tasks.py
msgid "Confirmed 👍"
msgstr "Принято 👍"

#: employee_bot/bot/handlers/member/tasks.py
msgid "↩️ Sent back with your comment."
msgstr "↩️ Возвращено с вашим комментарием."

#: employee_bot/bot/handlers/member/tasks.py
msgid "Why can't it be done?"
msgstr "Почему не получается?"

#: employee_bot/bot/handlers/member/tasks.py
msgid "✍️ What's in the way? Write a few words."
msgstr "✍️ Что мешает? Напишите пару слов."

#: employee_bot/bot/handlers/member/tasks.py
msgid "⛔ Sent. Reminders wait until someone decides."
msgstr "⛔ Отправлено. Напоминания на паузе, пока не примут решение."

#: employee_bot/bot/handlers/member/tasks.py
msgid "I didn't catch the time."
msgstr "Не удалось понять время."

#: employee_bot/bot/handlers/member/tasks.py
msgid "🕒 Asked for more time. The answer comes here."
msgstr "🕒 Запрос отправлен. Ответ придёт сюда."

#: employee_bot/bot/handlers/member/tasks.py
msgid "🕒 New deadline set."
msgstr "🕒 Новый срок установлен."

#: employee_bot/bot/handlers/member/tasks.py
msgid "👋 Reminder sent."
msgstr "👋 Напоминание отправлено."

#: employee_bot/bot/handlers/member/tasks.py
msgid "👤 Given to someone else."
msgstr "👤 Передана другому."

#: employee_bot/bot/handlers/member/tasks.py
msgid "✖️ Task cancelled."
msgstr "✖️ Задача отменена."

#: owner_bot/ownerbot/bot_messages.py
msgid "Tashkent"
msgstr "Ташкент"

#: owner_bot/ownerbot/bot_messages.py
msgid "Almaty"
msgstr "Алматы"

#: owner_bot/ownerbot/bot_messages.py
msgid "Moscow"
msgstr "Москва"

#: owner_bot/ownerbot/bot_messages.py
msgid "Dubai"
msgstr "Дубай"

#: owner_bot/ownerbot/bot_messages.py
msgid "📊 Open dashboard"
msgstr "📊 Открыть панель управления"

#: owner_bot/ownerbot/bot_messages.py
msgid "there"
msgstr "уважаемый пользователь"

#: owner_bot/ownerbot/bot_messages.py
#, python-format
msgid "Hello, %(name)s! 👋"
msgstr "Здравствуйте, %(name)s! 👋"

#: owner_bot/ownerbot/bot_messages.py
msgid "Your companies:"
msgstr "Ваши компании:"

#: owner_bot/ownerbot/bot_messages.py
#, python-format
msgid "%(count)d waiting for you"
msgid_plural "%(count)d waiting for you"
msgstr[0] "%(count)d дело ждёт вас"
msgstr[1] "%(count)d дела ждут вас"
msgstr[2] "%(count)d дел ждут вас"
msgstr[3] "%(count)d дела ждут вас"

#: owner_bot/ownerbot/bot_messages.py
msgid "/today: today's numbers and what waits for you"
msgstr "/today: показатели за сегодня и дела, которые ждут вас"

#: owner_bot/ownerbot/bot_messages.py
msgid "/dashboard: open the dashboard"
msgstr "/dashboard: открыть панель управления"

#: owner_bot/ownerbot/bot_messages.py
msgid "/new: create another company"
msgstr "/new: создать ещё одну компанию"

#: owner_bot/ownerbot/bot_messages.py
msgid ""
"Here you create your company, confirm dashboard sign-ins and get approvals "
"and alerts from your business."
msgstr ""
"Здесь вы создаёте компанию, подтверждаете вход в панель управления и "
"получаете запросы на одобрение и оповещения от своего бизнеса."

#: owner_bot/ownerbot/bot_messages.py
msgid "Start with /new to create your company."
msgstr "Чтобы создать компанию, начните с /new."

#: owner_bot/ownerbot/bot_messages.py
msgid "Your dashboard: every task, sale, payment and person in one place."
msgstr ""
"Ваша панель управления: все задачи, продажи, платежи и сотрудники в одном "
"месте."

#: owner_bot/ownerbot/bot_messages.py
#, python-format
msgid "Open your dashboard: %(url)s"
msgstr "Откройте панель управления: %(url)s"

#: owner_bot/ownerbot/bot_messages.py
msgid "The dashboard address isn't set on this server yet."
msgstr "Адрес панели управления на этом сервере ещё не настроен."

#: owner_bot/ownerbot/bot_messages.py
msgid "Cancel"
msgstr "Отмена"

#: owner_bot/ownerbot/bot_messages.py
msgid "New company"
msgstr "Новая компания"

#: owner_bot/ownerbot/bot_messages.py
msgid "Send the signup code you were given (like K7M2-QX9P)."
msgstr "Пришлите код регистрации, который вам выдали (например, K7M2-QX9P)."

#: owner_bot/ownerbot/bot_messages.py
msgid ""
"This signup code isn't valid. Check it and send it again, or ask for a new "
"one."
msgstr ""
"Этот код регистрации недействителен. Проверьте его и пришлите снова или "
"попросите новый."

#: owner_bot/ownerbot/bot_messages.py
msgid "What is your company called? Send its name, as staff know it."
msgstr ""
"Как называется ваша компания? Пришлите название, под которым её знают "
"сотрудники."

#: owner_bot/ownerbot/bot_messages.py
msgid "Send the name as text, up to 200 characters."
msgstr "Пришлите название текстом, до 200 символов."

#: owner_bot/ownerbot/bot_messages.py
msgid "Which timezone does the company work in?"
msgstr "В каком часовом поясе работает компания?"

#: owner_bot/ownerbot/bot_messages.py
msgid "Tashkent fits all of Uzbekistan."
msgstr "Ташкентское время подходит для всего Узбекистана."

#: owner_bot/ownerbot/bot_messages.py
msgid "⌨️ Type another"
msgstr "⌨️ Ввести другой"

#: owner_bot/ownerbot/bot_messages.py
msgid "Send the timezone or city, like Asia/Samarkand or Bishkek."
msgstr "Пришлите часовой пояс или город, например Asia/Samarkand или Бишкек."

#: owner_bot/ownerbot/bot_messages.py
msgid ""
"I don't know that timezone. Try a city name, like Almaty or Asia/Bishkek."
msgstr ""
"Я не знаю такого часового пояса. Попробуйте название города, например Алматы "
"или Asia/Bishkek."

#: owner_bot/ownerbot/bot_messages.py
msgid "Create this company?"
msgstr "Создать эту компанию?"

#: owner_bot/ownerbot/bot_messages.py
#, python-format
msgid "Timezone: %(zone)s"
msgstr "Часовой пояс: %(zone)s"

#: owner_bot/ownerbot/bot_messages.py
#, python-format
msgid "Language: %(language)s"
msgstr "Язык: %(language)s"

#: owner_bot/ownerbot/bot_messages.py
#, python-format
msgid "Base currency: %(currency)s"
msgstr "Базовая валюта: %(currency)s"

#: owner_bot/ownerbot/bot_messages.py
msgid "You can change all of this later in the dashboard settings."
msgstr "Всё это можно изменить позже в настройках панели управления."

#: owner_bot/ownerbot/bot_messages.py
msgid "✅ Create"
msgstr "✅ Создать"

#: owner_bot/ownerbot/bot_messages.py
msgid "✏️ Change name"
msgstr "✏️ Изменить название"

#: owner_bot/ownerbot/bot_messages.py
#, python-format
msgid "%(name)s is ready."
msgstr "Компания %(name)s готова."

#: owner_bot/ownerbot/bot_messages.py
msgid "You are its owner. Next: add your branches and invite your staff."
msgstr "Вы её владелец. Дальше: добавьте филиалы и пригласите сотрудников."

#: owner_bot/ownerbot/bot_messages.py
msgid "🚀 Open Get started"
msgstr "🚀 Открыть «Начало работы»"

#: owner_bot/ownerbot/bot_messages.py
#, python-format
msgid "Get started: %(url)s"
msgstr "Начало работы: %(url)s"

#: owner_bot/ownerbot/bot_messages.py
msgid "Cancelled. Nothing was created."
msgstr "Отменено. Ничего не создано."

#: owner_bot/ownerbot/bot_messages.py
msgid ""
"You don't have a company with dashboard access yet. Create one with /new."
msgstr ""
"У вас пока нет компании с доступом к панели управления. Создайте её "
"командой /new."

#: owner_bot/ownerbot/bot_messages.py
msgid "Which company?"
msgstr "Какую компанию показать?"

#: owner_bot/ownerbot/bot_messages.py
#, python-format
msgid "📥 Approvals (%(count)d)"
msgstr "📥 На одобрение (%(count)d)"

#: owner_bot/ownerbot/brief.py
msgid "open"
msgstr "открыт"

#: owner_bot/ownerbot/brief.py
msgid "not opened yet"
msgstr "ещё не открыт"

#: owner_bot/ownerbot/brief.py
msgid "closed"
msgstr "закрыт"

#: owner_bot/ownerbot/brief.py
msgid "day off"
msgstr "выходной"

#: owner_bot/ownerbot/brief.py
#, python-format
msgid "opened at %(time)s by %(name)s"
msgstr "открыт в %(time)s (%(name)s)"

#: owner_bot/ownerbot/brief.py
#, python-format
msgid "opened at %(time)s"
msgstr "открыт в %(time)s"

#: owner_bot/ownerbot/brief.py
#, python-format
msgid "not opened yet (opens %(time)s)"
msgstr "ещё не открыт (откроется в %(time)s)"

#: owner_bot/ownerbot/brief.py
#, python-format
msgid "%(count)d decision waits for you."
msgid_plural "%(count)d decisions wait for you."
msgstr[0] "%(count)d вопрос ждёт вашего решения."
msgstr[1] "%(count)d вопроса ждут вашего решения."
msgstr[2] "%(count)d вопросов ждут вашего решения."
msgstr[3] "%(count)d вопроса ждут вашего решения."

#: owner_bot/ownerbot/brief.py
msgid "Nothing waits for your decision."
msgstr "Вашего решения ничего не ждёт."

#: owner_bot/ownerbot/commands.py
msgid "Today at a glance"
msgstr "Сводка за сегодня"

