msgid "✅ I've read it"
msgstr "✅ Прочитано"

#: backend/apps/announcements/bot_messages.py
msgid "✅ You have read this."
msgstr "✅ Вы это прочитали."

#: backend/apps/announcements/bot_messages.py
#, python-format
msgid "📣 Read by %(read)d of %(total)d."
msgstr "📣 Прочитали %(read)d из %(total)d."

#: backend/apps/announcements/bot_messages.py
#, python-format
msgid "Not yet: %(names)s"
msgstr "Ещё не прочитали: %(names)s"

#: backend/apps/announcements/bot_messages.py
#, python-format
msgid ""
"📣 A day later, %(unread)d of %(total)d people still haven't read your "
"announcement “%(title)s”: %(names)s"
msgstr ""
"📣 Прошли сутки, а %(unread)d из %(total)d так и не прочитали ваше "
"объявление «%(title)s»: %(names)s"

#: backend/apps/announcements/bot_messages.py
#: backend/apps/groups/bot_messages.py backend/apps/reports/bot_messages.py
#, python-format
msgid "…and %(count)d more"
msgstr "…и ещё %(count)d"

#: backend/apps/announcements/bot_messages.py
msgid "👀 Who has read it?"
msgstr "👀 Кто прочитал?"

#: backend/apps/announcements/bot_messages.py
