msgstr "Задача передана другому сотруднику"

#: backend/apps/tasks/audit_actions.py
msgid "Nudged someone about a task"
msgstr "Отправлено напоминание по задаче"

#: backend/apps/tasks/audit_actions.py
msgid "Gave a new person their onboarding tasks"
msgstr "Новому сотруднику выданы задачи адаптации"

#: backend/apps/tasks/audit_actions.py
msgid "Changed several tasks at once"
msgstr "Изменено несколько задач сразу"

#: backend/apps/tasks/audit_actions.py
msgid "Undid finishing a task"
msgstr "Отмена выполнения задачи"

#: backend/apps/tasks/audit_actions.py
msgid "Said they can't do a task"
msgstr "Не может выполнить задачу"

#: backend/apps/tasks/audit_actions.py
msgid "Decided about a task someone couldn't do"
msgstr "Решение по задаче, которую не удалось выполнить"

#: backend/apps/tasks/audit_actions.py
msgid "Asked for more time"
msgstr "Запрос дополнительного времени"

#: backend/apps/tasks/audit_actions.py
msgid "Decided about more time for a task"
msgstr "Решение о дополнительном времени"

#: backend/apps/tasks/audit_actions.py
msgid "Accepted automatically: nobody reviewed it in time"
msgstr "Принято автоматически: никто не проверил вовремя"

#: backend/apps/tasks/audit_actions.py
msgid "Changed the rules for finished tasks"
msgstr "Изменение правил приёмки выполненных задач"

#: backend/apps/tasks/audit_actions.py
