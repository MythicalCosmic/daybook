msgstr "Срок: %(when)s"

#: backend/apps/tasks/bot_messages.py
#, python-format
msgid "Next reminder: %(time)s"
msgstr "Следующее напоминание: %(time)s"

#: backend/apps/tasks/bot_messages.py
